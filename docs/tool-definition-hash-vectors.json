    {
      "about": "An integer past 2^53 is read as the nearest double, as RFC 8785 requires",
      "input": "{\"name\":\"big\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\",\"maximum\":12345678901234567890}}}}",
      "canonical": "{\"inputSchema\":{\"properties\":{\"id\":{\"maximum\":12345678901234567000,\"type\":\"integer\"}},\"type\":\"object\"},\"name\":\"big\"}",
