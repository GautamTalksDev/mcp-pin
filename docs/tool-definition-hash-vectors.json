      "input": "{\n  \"numbers\": [333333333.33333329, 1E30, 4.50,\n              2e-3, 0.000000000000000000000000001],\n  \"string\": \"\\u20ac$\\u000F\\u000aA'\\u0042\\u0022\\u005c\\\\\\\"\\/\",\n  \"literals\": [null, true, false]\n}",
      "canonical": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\"€$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\"}",
      "hash": "2d5e01a318d0f0879ab568c4be289c8b1f64ef8921a53c6277d5e069978baacb"
    },
    {
      "about": "Numbers in a schema: 1.0 is 1, 1E3 is 1000, -0 is 0, 1e-7 keeps its exponent",
      "input": "{\"name\":\"n\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"k\":{\"type\":\"number\",\"minimum\":1.0,\"maximum\":1E3,\"multipleOf\":0.000001,\"default\":-0,\"exclusiveMinimum\":1e-7}}}}",
      "canonical": "{\"inputSchema\":{\"properties\":{\"k\":{\"default\":0,\"exclusiveMinimum\":1e-7,\"maximum\":1000,\"minimum\":1,\"multipleOf\":0.000001,\"type\":\"number\"}},\"type\":\"object\"},\"name\":\"n\"}",
      "hash": "913c935b054edcf4398e3e5de60422a1f057f7970ff214a25bc48eb67a6d810f"
