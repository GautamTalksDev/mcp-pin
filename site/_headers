# Cloudflare Pages sends these as real HTTP headers. A CSP in a meta tag
# cannot enforce frame-ancestors, so the policy belongs here.
/*
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  X-Frame-Options: DENY

/log.ndjson
  Access-Control-Allow-Origin: *
  Content-Type: application/x-ndjson

/head.json
  Access-Control-Allow-Origin: *

/PUBLIC_KEY.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8

/pagination-recrawl.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json

/incomplete-crawl-2026-09-04.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json

/api/*
  Access-Control-Allow-Origin: *

/badge/*
  Cache-Control: public, max-age=3600

# Styles and script are versioned by a content hash in their URL; fonts never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=604800
