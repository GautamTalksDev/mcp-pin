# Cloudflare Pages sends these as real HTTP headers. A CSP in a meta tag
# cannot enforce frame-ancestors, so the policy belongs here.
#
# Scripts run from this site's own files only, plus the inline scripts of the
# two self-contained pages (install, spot), allowed by hash: site/build.js
# fills in __INLINE_SCRIPT_HASHES__, so any other inline script is refused.
# Trusted Types: no string reaches an HTML sink except through the spot page's
# one named policy.
/*
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' __INLINE_SCRIPT_HASHES__; media-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types spot
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none

/log.ndjson
  Access-Control-Allow-Origin: *
  Content-Type: application/x-ndjson

/head.json
  Access-Control-Allow-Origin: *

/PUBLIC_KEY.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8

/pagination-recrawl.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json

/incomplete-crawl-2026-09-04.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json

/api/*
  Access-Control-Allow-Origin: *

/badge/*
  Cache-Control: public, max-age=3600

# Styles and script are versioned by a content hash in their URL; fonts never
# change. None of these is for other sites to load.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

/media/*
  Cache-Control: public, max-age=604800
  Cross-Origin-Resource-Policy: same-origin
